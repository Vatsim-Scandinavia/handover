includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - tests
    tmpDir: storage/framework/cache/phpstan

    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false

    strictRules:
        # PHPUnit assertions are static, but $this->assert*() is the Laravel idiom.
        dynamicCallOnStaticMethod: false

    # Services should arrive through constructors. Where that is not workable,
    # resolve() is the fallback; Rector rewrites app(X) to it.
    disallowedFunctionCalls:
        -
            function: 'app()'
            message: 'inject the dependency through the constructor, or use resolve() if that is not workable'
            allowIn:
                - bootstrap/*
                - config/*
    disallowedStaticCalls:
        -
            method:
                - 'Illuminate\Support\Facades\App::make()'
                - 'Illuminate\Support\Facades\App::makeWith()'
                - 'Illuminate\Container\Container::getInstance()'
            message: 'inject the dependency through the constructor, or use resolve() if that is not workable'
