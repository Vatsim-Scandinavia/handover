{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3.13",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.5.2",
        "league/oauth2-client": "^2.6.1",
        "sentry/sentry-laravel": "^4.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.23.0",
        "larastan/larastan": "^3.15",
        "laravel/boost": "^2.5",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.8",
        "spatie/laravel-ignition": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.15"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3.13"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/passport"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "lint": [
            "rector",
            "pint"
        ],
        "test:lint": [
            "rector --dry-run",
            "pint --test"
        ],
        "test:types": "phpstan analyse --memory-limit=1G",
        "test:unit": "phpunit",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
